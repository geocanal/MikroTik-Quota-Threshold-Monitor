{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "id": 1,
      "title": "WAN1 & WAN2 Quota Usage (%)",
      "type": "gauge",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "postgres",
        "uid": "PCC52D03280B7034C"
      },
      "targets": [
        {
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT CASE interface_name WHEN 'wan1' THEN 'Vodafone DSL (WAN1)' WHEN 'wan2' THEN 'WE Egypt (WAN2)' ELSE UPPER(interface_name) END AS isp, used_percentage::float AS used_pct FROM view_mikrotik_wan_quota_status ORDER BY interface_name;",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 100,
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "#EAB839",
                "value": 80
              },
              {
                "color": "red",
                "value": 95
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": true,
          "fields": "/used_pct/",
          "calcs": [
            "lastNotNull"
          ]
        },
        "showThresholdLabels": true,
        "showThresholdMarkers": true
      }
    },
    {
      "id": 2,
      "title": "Traffic Distribution (WAN1 vs WAN2)",
      "type": "piechart",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "datasource": {
        "type": "postgres",
        "uid": "PCC52D03280B7034C"
      },
      "targets": [
        {
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT 'WAN1' AS metric, ROUND(COALESCE(SUM(wan1_rx_bytes + wan1_tx_bytes), 0)/(1024.0*1024.0*1024.0), 2) AS value FROM mikrotik_wan_usage WHERE $__timeFilter(usage_at) AND counter_reset = false UNION ALL SELECT 'WAN2' AS metric, ROUND(COALESCE(SUM(wan2_rx_bytes + wan2_tx_bytes), 0)/(1024.0*1024.0*1024.0), 2) AS value FROM mikrotik_wan_usage WHERE $__timeFilter(usage_at) AND counter_reset = false;",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "decgbytes"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "right",
          "showLegend": true
        },
        "pieType": "donut",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "/value/",
          "values": false
        },
        "tooltip": {
          "mode": "single"
        }
      }
    },
    {
      "id": 3,
      "title": "Throughput / Bandwidth Consumption (MB per Sample)",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 8
      },
      "datasource": {
        "type": "postgres",
        "uid": "PCC52D03280B7034C"
      },
      "targets": [
        {
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT usage_at AS time, ROUND((wan1_rx_bytes + wan1_tx_bytes)/(1024.0*1024.0), 2) AS wan1_mb, ROUND((wan2_rx_bytes + wan2_tx_bytes)/(1024.0*1024.0), 2) AS wan2_mb, ROUND(total_bytes/(1024.0*1024.0), 2) AS total_mb FROM mikrotik_wan_usage WHERE $__timeFilter(usage_at) AND counter_reset = false ORDER BY usage_at ASC;",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "fillOpacity": 10
          },
          "unit": "mbytes"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max",
            "sum"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 4,
      "title": "Daily Consumption (GB) - Last 30 Days",
      "type": "barchart",
      "gridPos": {
        "h": 8,
        "w": 14,
        "x": 0,
        "y": 16
      },
      "datasource": {
        "type": "postgres",
        "uid": "PCC52D03280B7034C"
      },
      "targets": [
        {
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT (usage_date::timestamp AT TIME ZONE 'Africa/Cairo') AS time, wan1_total_gb AS wan1, wan2_total_gb AS wan2 FROM view_mikrotik_wan_daily_usage WHERE usage_date >= ((CURRENT_TIMESTAMP AT TIME ZONE 'Africa/Cairo')::date - INTERVAL '30 days') ORDER BY usage_date ASC;",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "decgbytes",
          "custom": {
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "xField": "time",
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 5,
      "title": "ISP Quota Cycle Summary",
      "type": "table",
      "gridPos": {
        "h": 8,
        "w": 10,
        "x": 14,
        "y": 16
      },
      "datasource": {
        "type": "postgres",
        "uid": "PCC52D03280B7034C"
      },
      "targets": [
        {
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT UPPER(interface_name) AS interface, provider_name AS provider, quota_gb || ' GB' AS quota, used_gb || ' GB' AS used, remaining_gb || ' GB' AS remaining, used_percentage || '%' AS used_pct, daily_burn_rate_gb || ' GB/d' AS burn_rate, projected_exhaustion_date::text AS exhaustion_date, days_left || ' days (' || renewal_date || ')' AS renewal FROM view_mikrotik_wan_quota_status ORDER BY interface_name;",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showHeader": true
      }
    }
  ],
  "refresh": "1m",
  "schemaVersion": 38,
  "style": "dark",
  "tags": [
    "mikrotik",
    "quota",
    "network"
  ],
  "time": {
    "from": "now-24h",
