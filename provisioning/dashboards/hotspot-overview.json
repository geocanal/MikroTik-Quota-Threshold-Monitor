{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "id": 1,
      "title": "Online Hotspot Sessions Right Now",
      "type": "stat",
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "postgres",
        "uid": "PCC52D03280B7034C"
      },
      "targets": [
        {
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT COUNT(DISTINCT user_name) AS active_users FROM hotspot_user_telemetry WHERE is_active = TRUE AND recorded_at >= (NOW() - INTERVAL '10 minutes');",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "unit": "none"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "/active_users/",
          "values": false
        },
        "textMode": "auto",
        "graphMode": "none"
      }
    },
    {
      "id": 2,
      "title": "Traffic Share by User Profile (MB)",
      "type": "piechart",
      "gridPos": {
        "h": 6,
        "w": 10,
        "x": 6,
        "y": 0
      },
      "datasource": {
        "type": "postgres",
        "uid": "PCC52D03280B7034C"
      },
      "targets": [
        {
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT COALESCE(profile, 'Default') AS metric, ROUND(SUM(total_mb), 2) AS value FROM (SELECT DISTINCT ON (user_name) profile, total_mb FROM hotspot_user_telemetry ORDER BY user_name, recorded_at DESC) u GROUP BY COALESCE(profile, 'Default') HAVING ROUND(SUM(total_mb), 2) > 0;",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "mbytes"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "right",
          "showLegend": true
        },
        "pieType": "donut",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "/value/",
          "values": false
        },
        "tooltip": {
          "mode": "single"
        }
      }
    },
    {
      "id": 3,
      "title": "High Quota Consumers (Alert Tier >= 80%)",
      "type": "stat",
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 16,
        "y": 0
      },
      "datasource": {
        "type": "postgres",
        "uid": "PCC52D03280B7034C"
      },
      "targets": [
        {
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT COUNT(DISTINCT user_name) AS alerting_users FROM hotspot_user_telemetry WHERE alert_tier IN ('80%', '100%') AND recorded_at >= (NOW() - INTERVAL '24 hours');",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "#EAB839",
                "value": 1
              },
              {
                "color": "red",
                "value": 3
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "/alerting_users/",
          "values": false
        },
        "textMode": "auto",
        "graphMode": "none"
      }
    },
    {
      "id": 4,
      "title": "Top 10 Heavy Hotspot Users (Cumulative)",
      "type": "table",
      "gridPos": {
        "h": 10,
        "w": 12,
        "x": 0,
        "y": 6
      },
      "datasource": {
        "type": "postgres",
        "uid": "PCC52D03280B7034C"
      },
      "targets": [
        {
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT ROW_NUMBER() OVER (ORDER BY total_mb DESC) AS \"#\", user_name AS \"User\", COALESCE(profile, '-') AS \"Profile\", ROUND(total_mb, 0) AS \"Total (MB)\", ROUND(total_gb, 2) AS \"Total (GB)\", COALESCE(limit_gb::text || ' GB', 'No Limit') AS \"Limit\", is_active AS \"Online\", to_char(recorded_at AT TIME ZONE 'Africa/Cairo', 'MM-DD HH24:MI') AS \"Last Seen\" FROM (SELECT DISTINCT ON (user_name) * FROM hotspot_user_telemetry ORDER BY user_name, recorded_at DESC) latest WHERE total_mb > 0 ORDER BY total_mb DESC LIMIT 10;",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto"
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Total (MB)" },
            "properties": [
              { "id": "unit", "value": "none" },
              { "id": "custom.width", "value": 100 }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Total (GB)" },
            "properties": [
              { "id": "unit", "value": "decgbytes" },
              { "id": "custom.width", "value": 100 }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Online" },
            "properties": [
              {
                "id": "custom.displayMode",
                "value": "color-background"
              },
              {
                "id": "mappings",
                "value": [
                  { "type": "value", "options": { "true":  { "text": "🟢 Yes", "color": "green",  "index": 0 } } },
                  { "type": "value", "options": { "false": { "text": "⚫ No",  "color": "text",    "index": 1 } } }
                ]
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "sortBy": [{ "displayName": "Total (MB)", "desc": true }]
      }
    },
    {
      "id": 5,
      "title": "Hotspot Quota & Incident Audit (All Active Users)",
      "type": "table",
      "gridPos": {
        "h": 10,
        "w": 12,
        "x": 12,
        "y": 6
      },
      "datasource": {
        "type": "postgres",
        "uid": "PCC52D03280B7034C"
      },
      "targets": [
        {
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT user_name AS \"User\", COALESCE(profile, '-') AS \"Profile\", total_gb || ' GB' AS \"Used\", COALESCE(limit_gb::text || ' GB', 'No Limit') AS \"Limit\", COALESCE(remaining_gb::text || ' GB', '-') AS \"Remaining\", used_percentage || '%' AS \"Usage %\", CASE alert_tier WHEN 'NORMAL' THEN 'OK' WHEN '80%' THEN '⚠ 80%+' WHEN '100%' THEN '🔴 Exceeded' ELSE alert_tier END AS \"Status\", to_char(recorded_at AT TIME ZONE 'Africa/Cairo', 'MM-DD HH24:MI') AS \"Last Seen\" FROM (SELECT DISTINCT ON (user_name) * FROM hotspot_user_telemetry ORDER BY user_name, recorded_at DESC) latest WHERE total_mb > 0 ORDER BY total_mb DESC LIMIT 25;",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Status" },
            "properties": [
              {
                "id": "custom.displayMode",
                "value": "color-text"
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    { "color": "green", "value": null }
                  ]
                }
              },
              {
                "id": "mappings",
                "value": [
                  { "type": "value", "options": { "OK": { "color": "green", "index": 0 } } },
                  { "type": "value", "options": { "⚠ 80%+": { "color": "yellow", "index": 1 } } },
                  { "type": "value", "options": { "🔴 Exceeded": { "color": "red", "index": 2 } } }
                ]
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true
      }
    }
  ],
  "refresh": "1m",
  "schemaVersion": 38,
  "style": "dark",
  "tags": [
    "mikrotik",
    "hotspot",
    "users"
  ],
  "time": {
    "from": "now-24h",
    "to": "now"
